#include <stdio.h>
#include <string.h>

/* Sort items alphabetically */
void sortItems(char items[][20], int total[], int count) {
    int i, j;
    char tempItem[20];
    int tempQty;

    for (i = 0; i < count - 1; i++) {
        for (j = i + 1; j < count; j++) {
            if (strcmp(items[i], items[j]) > 0) {
                strcpy(tempItem, items[i]);
                strcpy(items[i], items[j]);
                strcpy(items[j], tempItem);

                tempQty = total[i];
                total[i] = total[j];
                total[j] = tempQty;
            }
        }
    }
}

int main() {
    FILE *fp;
    char item[20], items[20][20];
    int total[20] = {0};
    float subtotal;
    int count = 0, found;
    int i, choice, qty;

    /* LOAD DATA FROM FILE */
    fp = fopen("sales.txt", "r");
    if (fp != NULL) {
        while (fscanf(fp, "%s %d %f", item, &qty, &subtotal) != EOF) {
            found = 0;
            for (i = 0; i < count; i++) {
                if (strcmp(items[i], item) == 0) {
                    total[i] += qty;
                    found = 1;
                    break;
                }
            }
            if (!found && count < 20) {
                strcpy(items[count], item);
                total[count] = qty;
                count++;
            }
        }
        fclose(fp);
        sortItems(items, total, count);
    }

    do {
        printf("\n===== MENU =====\n");
        printf("1. Show Receipt\n");
        printf("2. Add/Edit Item\n");
        printf("3. Search Item\n");
        printf("4. Remove Item\n");
        printf("5. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice) {

        /* SHOW RECEIPT */
        case 1: {
            int totalItems = 0, best = 0;

            printf("\n===============================\n");
            printf("        STORE NO: 2025\n");
            printf("    SOCHIPS SCHOOL SUPPLY SHOP\n");
            printf("===============================\n");

            printf("%-15s %-5s %-8s\n", "Item", "Qty", "Subtotal");
            printf("--------------------------------\n");

            for (i = 0; i < count; i++) {
                subtotal = total[i];
                printf("%-15s %-5d %-8.0f\n", items[i], total[i], subtotal);

                totalItems += total[i];
                if (total[i] > total[best])
                    best = i;
            }

            printf("--------------------------------\n");
            printf("Total Items Sold: %d\n", totalItems);
            if (count > 0)
                printf("Best Seller: %s\n", items[best]);
            printf("===============================\n");
            printf("Thank you!\n");

            /* WRITE RECEIPT TO sales_summary.txt */
            FILE *summary = fopen("sales_summary.txt", "w");

            fprintf(summary, "===============================\n");
            fprintf(summary, "        STORE NO: 2025\n");
            fprintf(summary, "    SIMPLE SCHOOL SUPPLY SHOP\n");
            fprintf(summary, "===============================\n");

            fprintf(summary, "%-15s %-5s %-8s\n", "Item", "Qty", "Subtotal");
            fprintf(summary, "--------------------------------\n");

            for (i = 0; i < count; i++) {
                subtotal = total[i];
                fprintf(summary, "%-15s %-5d %-8.0f\n",
                        items[i], total[i], subtotal);
            }

            fprintf(summary, "--------------------------------\n");
            fprintf(summary, "Total Items Sold: %d\n", totalItems);
            if (count > 0)
                fprintf(summary, "Best Seller: %s\n", items[best]);
            fprintf(summary, "===============================\n");
            fprintf(summary, "Thank you!\n");

            fclose(summary);
            break;
        }

        /* ADD / EDIT ITEM */
        case 2: {
            printf("\nEnter item name: ");
            scanf("%s", item);
            printf("Enter quantity: ");
            scanf("%d", &qty);

            found = 0;
            for (i = 0; i < count; i++) {
                if (strcmp(items[i], item) == 0) {
                    total[i] += qty;
                    found = 1;
                    break;
                }
            }

            if (!found && count < 20) {
                strcpy(items[count], item);
                total[count] = qty;
                count++;
            }

            sortItems(items, total, count);

            fp = fopen("sales.txt", "w");
            for (i = 0; i < count; i++) {
                fprintf(fp, "%s %d 0\n", items[i], total[i]);
            }
            fclose(fp);

            printf("Item added/updated successfully!\n");
            break;
        }

        /* SEARCH ITEM */
        case 3: {
            char search[20];
            int foundSearch = 0;

            printf("\nEnter item name to search: ");
            scanf("%s", search);

            printf("\n%-15s %-5s\n", "Item", "Qty");
            printf("------------------\n");

            for (i = 0; i < count; i++) {
                if (strcmp(items[i], search) == 0) {
                    printf("%-15s %-5d\n", items[i], total[i]);
                    foundSearch = 1;
                    break;
                }
            }

            if (!foundSearch)
                printf("Item not found.\n");
            break;
        }

        /* REMOVE ITEM */
        case 4: {
            char removeItem[20];
            int removeIndex = -1;

            printf("\nEnter item name to remove: ");
            scanf("%s", removeItem);

            for (i = 0; i < count; i++) {
                if (strcmp(items[i], removeItem) == 0) {
                    removeIndex = i;
                    break;
                }
            }

            if (removeIndex == -1) {
                printf("Item not found.\n");
                break;
            }

            for (i = removeIndex; i < count - 1; i++) {
                strcpy(items[i], items[i + 1]);
                total[i] = total[i + 1];
            }
            count--;

            fp = fopen("sales.txt", "w");
            for (i = 0; i < count; i++) {
                fprintf(fp, "%s %d 0\n", items[i], total[i]);
            }
            fclose(fp);

            printf("Item removed successfully!\n");
            break;
        }

        case 5:
            printf("Program exited.\n");
            break;

        default:
            printf("Invalid choice.\n");
        }

    } while (choice != 5);

    return 0;
}
